{
  "name": "squished-site",
  "compatibility_date": "2026-11-01",
  // The custom domain is attached to this Worker in the Cloudflare dashboard.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
